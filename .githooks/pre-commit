#!/bin/sh
# Auto-refresh the planner's architecture context doc when backend/schema/
# migration files change, so the "Live facts" block never goes stale.
# Enable once with: git config core.hooksPath .githooks

changed=$(git diff --cached --name-only)

echo "$changed" | grep -Eq '^(shared/schema\.ts|server/v2/modules/|migrations/|package\.json)' || exit 0

echo "[pre-commit] Refreshing architecture context doc..."
npm run --silent docs:arch || exit 0

# Re-stage the doc if the refresh changed it.
git add .claude/agents/context/architecture.md 2>/dev/null

exit 0
